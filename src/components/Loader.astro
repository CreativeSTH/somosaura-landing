<div id="siteLoader" class="site-loader" aria-hidden="true">
  <span class="site-loader-dot"></span>
  <p class="site-loader-text">Estamos cargando para ti</p>
</div>

<style>
  /* Pantalla de carga inicial del sitio — solo la primera entrada (ver
     loader.ts). Se oculta por completo si la carga viene de una navegación
     interna por nuestro propio wipe (clase .skip-loader, fijada por el
     script inline de Layout.astro antes del primer paint) — ahí ya corre el
     wipe solo, sin loader. */
  .site-loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    background: var(--bg);
  }

  .site-loader.is-done {
    display: none;
  }

  :global(html.skip-loader) .site-loader {
    display: none;
  }

  .site-loader-dot {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--accent-violet-glow);
    box-shadow: 0 0 18px var(--accent-violet-glow), 0 0 40px rgba(124, 92, 255, 0.65), 0 0 70px rgba(124, 92, 255, 0.35);
    animation: siteLoaderBounce 1.15s infinite;
  }

  .site-loader-text {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  /* Rebote con squash & stretch: cae acelerando, se aplasta al tocar el
     "piso", despega con un resorte, y sube DESACELERANDO hasta quedar un
     instante arriba antes de volver a caer — el bug que lo hacía sentir
     robótico era el tramo de subida (antes 55%→100%) con una curva de
     aceleración en vez de desaceleración, así que frenaba en seco al llegar
     arriba en vez de asentarse suave. */
  @keyframes siteLoaderBounce {
    0% {
      transform: translateY(-48px) scale(1, 1);
      animation-timing-function: cubic-bezier(0.5, 0, 1, 0.5);
    }
    44% {
      transform: translateY(0) scale(1.3, 0.74);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    54% {
      transform: translateY(-8px) scale(0.94, 1.08);
      animation-timing-function: cubic-bezier(0.33, 0, 0.2, 1);
    }
    100% {
      transform: translateY(-48px) scale(1, 1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-loader-dot {
      animation: none;
    }
  }
</style>
