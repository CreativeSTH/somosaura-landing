---
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
const appUrl = import.meta.env.PUBLIC_APP_URL;
const message = encodeURIComponent('Quiero probar AURA gratis por 20 días.');
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${message}`;

const menuLinks = [
  { label: 'Producto', href: '#punto-venta' },
  { label: 'Funciones', href: '#domicilios' },
  { label: 'Tienda online', href: '#tienda' },
];
---

<header class="topbar">
  <div class="topbar-inner">
    <button
      type="button"
      class="topbar-toggle"
      id="topbarToggle"
      aria-expanded="false"
      aria-controls="topbarMenu"
      aria-label="Abrir menú"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a class="topbar-logo" href="#inicio" aria-label="AURA — Inicio">
      <span class="topbar-logo-dot"></span>
      aura
    </a>

    <div class="topbar-actions">
      <a class="topbar-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer">
        Prueba gratis
      </a>
      <a class="topbar-enter" href={appUrl}>Entrar</a>
    </div>
  </div>

  <nav class="topbar-menu" id="topbarMenu">
    <div class="topbar-menu-links">
      {menuLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('topbarToggle');
  const menu = document.getElementById('topbarMenu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  /* Mobile-first: esto de acá es el layout base, igual a todos los anchos —
     hamburguesa | logo centrado | acciones, sin bordes en ningún lado. */
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    background: rgba(8, 6, 12, 0.75);
    backdrop-filter: blur(10px);
    /* Centro del clip-path circular del menú — coincide con el centro de la hamburguesa. */
    --menu-origin-x: 39px;
    --menu-origin-y: 32px;
  }
  .topbar-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 12px 20px;
    min-height: var(--topbar-height);
  }

  .topbar-toggle {
    justify-self: start;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 38px;
    height: 38px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .topbar-toggle span {
    display: block;
    width: 14px;
    height: 2px;
    background: var(--fg);
    border-radius: 2px;
  }

  .topbar-logo {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'M PLUS U', var(--font-sans);
    font-weight: 600;
    font-size: 19px;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .topbar-logo-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-violet-glow);
    box-shadow: 0 0 10px var(--accent-violet-glow), 0 0 24px rgba(124, 92, 255, 0.65), 0 0 44px rgba(124, 92, 255, 0.35);
  }

  .topbar-actions {
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
  }
  .topbar-cta {
    background: var(--accent-violet);
    color: #0a0612;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    border: none;
    box-shadow: 0 0 16px rgba(124, 92, 255, 0.4);
    transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out);
  }
  .topbar-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 20px rgba(124, 92, 255, 0.55);
  }
  .topbar-enter {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
  }
  .topbar-enter:hover {
    color: var(--fg);
  }

  /* Menú de la hamburguesa: no es un panel que se desliza — es un círculo que
     crece desde el centro de la hamburguesa (clip-path), con estilo vidrio
     igual que las tarjetas de producto. Como el origen del círculo está en la
     esquina superior izquierda del panel, lo que se ve mientras crece es
     literalmente un cuarto de círculo, superpuesto al topbar.
     Sin backdrop-filter a propósito — recalcular un blur sobre una región que
     crece con clip-path es pesado y se sentía lageado; en su lugar, un fondo
     sólido con el mismo degradado radial que el glare del QR al hover. */
  .topbar-menu {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle 200px at var(--menu-origin-x) var(--menu-origin-y), rgba(124, 92, 255, 0.55), transparent 70%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    clip-path: circle(0px at var(--menu-origin-x) var(--menu-origin-y));
    transition: clip-path 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    pointer-events: none;
  }
  .topbar-menu.open {
    clip-path: circle(240px at var(--menu-origin-x) var(--menu-origin-y));
    pointer-events: auto;
  }
  .topbar-menu-links {
    position: absolute;
    top: 74px;
    left: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }
  .topbar-menu.open .topbar-menu-links {
    opacity: 1;
    transition-delay: 0.15s;
  }
  .topbar-menu a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 0;
  }
  .topbar-menu a:hover {
    color: var(--fg);
  }

  @media (min-width: 900px) {
    .topbar-inner {
      padding: 0 40px;
    }
    .topbar {
      --menu-origin-x: 59px;
    }
    .topbar-menu {
      width: 400px;
      height: 400px;
      background: radial-gradient(circle 450px at var(--menu-origin-x) var(--menu-origin-y), #13151a, transparent 70%);
    }
    .topbar-menu.open {
      clip-path: circle(300px at var(--menu-origin-x) var(--menu-origin-y));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar-menu,
    .topbar-menu-links,
    .topbar-cta {
      transition: none;
    }
  }
</style>
