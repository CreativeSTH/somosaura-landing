---
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;
const appUrl = import.meta.env.PUBLIC_APP_URL;
const message = encodeURIComponent('Quiero probar AURA gratis por 20 días.');
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${message}`;

const menuLinks = [
  { label: 'Producto', href: '#punto-venta' },
  { label: 'Funciones', href: '#domicilios' },
  { label: 'Tienda online', href: '#tienda' },
];
---

<header class="topbar">
  <div class="topbar-inner">
    <button
      type="button"
      class="topbar-toggle"
      id="topbarToggle"
      aria-expanded="false"
      aria-controls="topbarMenu"
      aria-label="Abrir menú"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a class="topbar-logo" href="#inicio" aria-label="AURA — Inicio">
      <span class="topbar-logo-dot"></span>
      AURA
    </a>

    <div class="topbar-actions">
      <a class="topbar-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer">
        Prueba gratis
      </a>
      <a class="topbar-enter" href={appUrl}>Entrar</a>
    </div>
  </div>

  <nav class="topbar-menu" id="topbarMenu">
    {menuLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.getElementById('topbarToggle');
  const menu = document.getElementById('topbarMenu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  /* Mobile-first: esto de acá es el layout base, igual a todos los anchos —
     hamburguesa | logo centrado | acciones, sin bordes en ningún lado. */
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    background: rgba(8, 6, 12, 0.75);
    backdrop-filter: blur(10px);
  }
  .topbar-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 12px 20px;
    min-height: var(--topbar-height);
  }

  .topbar-toggle {
    justify-self: start;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 38px;
    height: 38px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .topbar-toggle span {
    display: block;
    width: 14px;
    height: 2px;
    background: var(--fg);
    border-radius: 2px;
  }

  .topbar-logo {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 16px;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .topbar-logo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-violet-glow);
    box-shadow: 0 0 8px var(--accent-violet-glow);
  }

  .topbar-actions {
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
  }
  .topbar-cta {
    background: var(--accent-violet);
    color: #0a0612;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    border: none;
    box-shadow: 0 0 16px rgba(124, 92, 255, 0.4);
    transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out);
  }
  .topbar-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 20px rgba(124, 92, 255, 0.55);
  }
  .topbar-enter {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
  }
  .topbar-enter:hover {
    color: var(--fg);
  }

  /* Menú desplegable de la hamburguesa — mismo comportamiento en cualquier ancho. */
  .topbar-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    padding: 0 20px;
    gap: 4px;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s var(--ease-out);
  }
  .topbar-menu.open {
    max-height: 240px;
    padding: 8px 20px 20px;
  }
  /* Sombra radial oscura desde la esquina de la hamburguesa — misma técnica que
     el "menu_scrim" de rainbow.me (un negro que se degrada). El de ellos es negro
     puro porque su fondo es gris oscuro (#111); el nuestro ya es casi negro
     (#08060c), así que un negro puro ahí encima no se notaría — uso un violeta
     muy oscuro en vez de neutro, para que el tinte se perciba igual. */
  .topbar-menu::before {
    content: '';
    position: absolute;
    top: -40px;
    left: -40px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle at top left, rgba(20, 10, 40, 0.9), transparent 70%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }
  .topbar-menu.open::before {
    opacity: 1;
  }
  .topbar-menu a {
    position: relative;
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 0;
  }
  .topbar-menu a:hover {
    color: var(--fg);
  }

  @media (min-width: 900px) {
    .topbar-inner {
      padding: 0 40px;
    }
    .topbar-menu {
      max-width: 220px;
      left: 40px;
      right: auto;
      border-radius: 0 0 14px 14px;
    }
    .topbar-menu.open {
      max-height: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar-menu,
    .topbar-cta {
      transition: none;
    }
  }
</style>
