---
interface Props {
  eyebrow: string;
  title: string;
  copy: string;
  badge?: string;
  /** La primera sección de cada página debe llevar el único <h1> real de esa
     página — el resto se queda en <h2>. Ver Section.astro/index.astro. */
  as?: 'h1' | 'h2';
}

const { eyebrow, title, copy, badge, as: Heading = 'h2' } = Astro.props;
const words = title.split(' ');
---

<div class="section-header">
  {badge && <span class="section-badge">{badge}</span>}
  <p class="section-eyebrow">{eyebrow}</p>
  <Heading class="section-title">
    {words.map((word, i) => (
      <span class="js-word" data-word-index={i}>
        {word}
        {i < words.length - 1 ? ' ' : ''}
      </span>
    ))}
  </Heading>
  <p class="section-copy">{copy}</p>
</div>

<style>
  .section-header {
    max-width: 340px;
  }
  .section-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--section-accent, var(--accent-violet));
    margin: 0 0 14px;
  }
  .section-title {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    line-height: 1.12;
    color: var(--fg);
    margin: 0 0 14px;
  }
  .section-copy {
    font-size: 15px;
    color: var(--fg-muted);
    margin: 0;
  }
  .section-badge {
    display: inline-block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    margin-bottom: 12px;
    background: rgba(255, 200, 80, 0.15);
    color: #ffd479;
    border: 1px solid rgba(255, 200, 80, 0.35);
    width: fit-content;
  }

  @media (max-width: 900px) {
    .section-header {
      max-width: 100%;
    }
  }
</style>
