---
import FeatureCard from './FeatureCard.astro';
import type { FeatureCardData } from '../lib/sections';

interface Props {
  cards: FeatureCardData[];
  dimmed?: boolean;
}

const { cards, dimmed = false } = Astro.props;
---

<div class:list={['card-cluster', { dimmed }]}>
  {cards.map((card) => (
    <FeatureCard
      icon={card.icon}
      title={card.title}
      value={card.value}
      badgeText={card.badgeText}
      badgeTone={card.badgeTone}
      sparkline={card.sparkline}
    />
  ))}
</div>

<style>
  .card-cluster {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 360px;
  }
  .card-cluster > :global(.feature-card) {
    width: 100%;
  }
  .card-cluster > :global(.feature-card:nth-child(odd)) {
    transform: rotate(-2deg) translateX(-8px);
  }
  .card-cluster > :global(.feature-card:nth-child(even)) {
    transform: rotate(2deg) translateX(8px);
  }
  .card-cluster > :global(.feature-card:not(:first-child)) {
    margin-top: -18px;
  }
  .card-cluster.dimmed {
    opacity: 0.55;
    filter: grayscale(0.35);
  }

  @media (min-width: 900px) {
    .card-cluster {
      max-width: 400px;
    }
  }
</style>
