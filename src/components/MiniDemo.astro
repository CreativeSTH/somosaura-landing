---
import Icon from './Icon.astro';

const products = [
  { name: 'Gaseosa', price: 8500, icon: 'cup-soda' },
  { name: 'Pan', price: 4200, icon: 'wheat' },
  { name: 'Combo', price: 15000, icon: 'package' },
];
---

<div class="mini-demo" id="miniDemo">
  <p class="mini-demo-title">Probalo — creá una venta real</p>
  <div class="mini-products">
    {products.map((p) => (
      <button type="button" class="mini-product" data-price={p.price}>
        <span class="mini-product-icon"><Icon name={p.icon} size={20} /></span>
        <span class="mini-product-name">{p.name}</span>
        <span class="mini-product-price">${p.price.toLocaleString('es-CO')}</span>
      </button>
    ))}
  </div>
  <div class="mini-cart-row">
    <span id="miniCartCount">0 items</span>
    <span id="miniCartTotal">$0</span>
  </div>
  <button type="button" class="mini-cobrar" id="miniCobrarBtn">Cobrar</button>
  <p class="mini-success" id="miniSuccess">✓ Venta creada — 2 clicks, cero pantallas nuevas.</p>
</div>

<script>
  import { formatCOP } from '../lib/formatCurrency';
  import { createCart } from '../lib/miniDemoCart';

  const root = document.getElementById('miniDemo');
  if (root) {
    const cart = createCart();
    const countEl = document.getElementById('miniCartCount')!;
    const totalEl = document.getElementById('miniCartTotal')!;
    const successEl = document.getElementById('miniSuccess')!;

    function render() {
      countEl.textContent = `${cart.items.length} items`;
      totalEl.textContent = formatCOP(cart.total());
    }

    root.querySelectorAll<HTMLButtonElement>('.mini-product').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.classList.add('added');
        cart.add(Number(btn.dataset.price));
        successEl.classList.remove('show');
        render();
      });
    });

    document.getElementById('miniCobrarBtn')?.addEventListener('click', () => {
      if (cart.items.length === 0) return;
      successEl.classList.add('show');
      setTimeout(() => {
        cart.clear();
        root.querySelectorAll('.mini-product.added').forEach((el) => el.classList.remove('added'));
        render();
      }, 2200);
    });
  }
</script>

<style>
  .mini-demo {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 18px;
    width: 100%;
    max-width: 320px;
  }

  @media (min-width: 900px) {
    .mini-demo {
      max-width: 400px;
      padding: 24px;
    }
  }
  .mini-demo-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-violet);
    margin: 0 0 12px;
    font-weight: 700;
  }
  .mini-products {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    padding: 6px 2px;
  }
  .mini-product {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(155deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    padding: 12px 6px 10px;
    text-align: center;
    cursor: pointer;
    font-size: 11px;
    color: var(--fg);
    font-weight: 600;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s var(--ease-out), border-color 0.15s;
  }
  .mini-product-icon {
    display: flex;
    color: var(--accent-violet);
    margin-bottom: 4px;
  }
  .mini-product-name {
    color: var(--fg-muted);
  }
  .mini-product-price {
    font-size: 13px;
    font-weight: 800;
    color: var(--accent-violet);
    margin-top: 2px;
  }
  /* Desordenadas a propósito, como un mazo de tarjetas tirado sobre la mesa. */
  .mini-products > .mini-product:nth-child(1) {
    transform: rotate(-5deg) translateY(4px);
  }
  .mini-products > .mini-product:nth-child(2) {
    transform: rotate(4deg) translateY(-6px);
  }
  .mini-products > .mini-product:nth-child(3) {
    transform: rotate(-3deg) translateY(5px);
  }
  .mini-product:hover {
    transform: translateY(-4px) scale(1.05) rotate(0deg);
    border-color: var(--accent-violet);
  }
  .mini-product.added {
    border-color: var(--accent-violet);
    background: rgba(150, 110, 255, 0.18);
  }
  .mini-cart-row {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--fg-muted);
    margin-bottom: 12px;
  }
  .mini-cobrar {
    width: 100%;
    background: var(--fg);
    border: none;
    color: #0a0612;
    font-weight: 700;
    padding: 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-size: 13px;
  }
  .mini-success {
    display: none;
    text-align: center;
    font-size: 12px;
    color: #b9f2c6;
    margin: 10px 0 0;
    font-weight: 600;
  }
  .mini-success.show {
    display: block;
  }

  @media (max-width: 400px) {
    .mini-products {
      flex-direction: column;
    }
  }
</style>
