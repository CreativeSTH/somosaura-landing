---
import Icon from './Icon.astro';

const products = [
  { name: 'Gaseosa', price: 8500, icon: 'cup-soda' },
  { name: 'Pan', price: 4200, icon: 'wheat' },
  { name: 'Combo', price: 15000, icon: 'package' },
];
---

<div class="mini-demo" id="miniDemo">
  <p class="mini-demo-title">Probalo — creá una venta real</p>
  <div class="mini-cart-icon" id="miniCartIcon" aria-hidden="true">
    <Icon name="shopping-bag" size={18} />
    <span class="mini-cart-badge" id="miniCartBadge">0</span>
  </div>
  <div class="mini-products">
    {products.map((p) => (
      <button type="button" class="mini-product" data-price={p.price}>
        <span class="mini-product-icon"><Icon name={p.icon} size={20} /></span>
        <span class="mini-product-name">{p.name}</span>
        <span class="mini-product-price">${p.price.toLocaleString('es-CO')}</span>
      </button>
    ))}
  </div>
  <div class="mini-cart-row">
    <span id="miniCartTotal">$0</span>
  </div>
  <button type="button" class="mini-cobrar" id="miniCobrarBtn">
    Cobrar
    <span class="mini-cobrar-glare"></span>
  </button>
</div>

<div class="mini-toast" id="miniToast" role="status" aria-live="polite"></div>

<!-- Modal de cobro — a nivel de página, no dentro de la tarjeta chica: bloquea y difumina el resto del sitio mientras está abierto. -->
<div class="mini-modal-backdrop" id="miniModalBackdrop">
  <!-- Panel 1: método fijo, cuánto recibe y cuánto devuelve -->
  <div class="mini-modal-panel mini-pay-panel" id="miniPayPanel">
    <p class="mini-dialog-eyebrow">Total a cobrar</p>
    <p class="mini-dialog-total" id="miniPayTotal">$0</p>

    <div class="mini-dialog-method-row">
      <span>Método de pago</span>
      <span class="mini-dialog-method-value">
        <Icon name="lock" size={11} />
        Efectivo
      </span>
    </div>

    <label class="mini-dialog-label" for="miniPayReceived">Recibe</label>
    <input type="number" inputmode="numeric" class="mini-dialog-input" id="miniPayReceived" placeholder="$0" />

    <div class="mini-dialog-change-row">
      <span>Devuelta</span>
      <span id="miniPayChange">$0</span>
    </div>

    <div class="mini-dialog-actions">
      <button type="button" class="mini-dialog-cancel" id="miniPayCancel">Cancelar</button>
      <button type="button" class="mini-dialog-confirm" id="miniPayConfirm">Pagar</button>
    </div>
  </div>

  <!-- Panel 2: imprimiendo factura -->
  <div class="mini-modal-panel mini-print-panel" id="miniPrintPanel">
    <span class="mini-spinner"></span>
    <p>Imprimiendo factura…</p>
  </div>

  <!-- Panel 3: alerta final -->
  <div class="mini-modal-panel mini-alert-panel" id="miniAlertPanel">
    <span class="mini-alert-icon"><Icon name="check-circle" size={30} /></span>
    <p class="mini-alert-title">Venta finalizada</p>
    <p class="mini-alert-sub">2 clicks, cero pantallas nuevas.</p>
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { formatCOP } from '../lib/formatCurrency';
  import { createCart } from '../lib/miniDemoCart';
  import { computeChange, suggestReceived } from '../lib/payment';
  import { prefersReducedMotion } from '../lib/motion';

  const root = document.getElementById('miniDemo');
  if (root) {
    const cart = createCart();
    const totalEl = document.getElementById('miniCartTotal')!;
    const cartIconEl = document.getElementById('miniCartIcon')!;
    const cartBadgeEl = document.getElementById('miniCartBadge')!;

    const backdrop = document.getElementById('miniModalBackdrop')!;
    const toastEl = document.getElementById('miniToast')!;
    // Reubicados como hijos directos de <body>: un ancestro con `filter` (el
    // sistema de reveal de motion.ts anima `.section-visual` con filter/blur)
    // crea su propio containing block y rompe `position: fixed` si se quedan
    // anidados ahí adentro.
    document.body.appendChild(backdrop);
    document.body.appendChild(toastEl);

    let toastTimer: ReturnType<typeof setTimeout> | null = null;

    function showToast(message: string) {
      toastEl.textContent = message;
      toastEl.classList.add('show');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.remove('show'), 2600);
    }

    const cobrarBtn = document.getElementById('miniCobrarBtn')!;
    cobrarBtn.addEventListener('mousemove', (e) => {
      const rect = cobrarBtn.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      const rx = (0.5 - y) * 8;
      const ry = (x - 0.5) * 8;
      cobrarBtn.style.setProperty('--tilt-rx', `${rx}deg`);
      cobrarBtn.style.setProperty('--tilt-ry', `${ry}deg`);
      cobrarBtn.style.setProperty('--tilt-gx', `${x * 100}%`);
      cobrarBtn.style.setProperty('--tilt-gy', `${y * 100}%`);
    });
    cobrarBtn.addEventListener('mouseleave', () => {
      cobrarBtn.style.setProperty('--tilt-rx', '0deg');
      cobrarBtn.style.setProperty('--tilt-ry', '0deg');
    });

    const payPanel = document.getElementById('miniPayPanel')!;
    const printPanel = document.getElementById('miniPrintPanel')!;
    const alertPanel = document.getElementById('miniAlertPanel')!;
    const panels = [payPanel, printPanel, alertPanel];

    const payTotalEl = document.getElementById('miniPayTotal')!;
    const receivedInput = document.getElementById('miniPayReceived') as HTMLInputElement;
    const changeEl = document.getElementById('miniPayChange')!;
    const confirmBtn = document.getElementById('miniPayConfirm') as HTMLButtonElement;

    function showPanel(panel: HTMLElement | null) {
      panels.forEach((p) => p.classList.toggle('show', p === panel));
    }

    function openModal() {
      backdrop.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      backdrop.classList.remove('open');
      document.body.style.overflow = '';
      showPanel(null);
    }

    function render() {
      totalEl.textContent = formatCOP(cart.total());
    }

    // Rebote elástico del ícono del carrito + pop del badge — el "impacto" al
    // terminar el vuelo (o al instante, con prefers-reduced-motion).
    function bumpCartBadge() {
      cartBadgeEl.textContent = String(cart.items.length);
      cartBadgeEl.classList.add('visible');

      if (prefersReducedMotion()) {
        gsap.set(cartBadgeEl, { scale: 1 });
        gsap.set(cartIconEl, { scale: 1 });
        return;
      }

      gsap.fromTo(cartBadgeEl, { scale: 0.6 }, { scale: 1, duration: 0.4, ease: 'back.out(2)' });
      gsap.fromTo(cartIconEl, { scale: 0.85 }, { scale: 1, duration: 0.5, ease: 'elastic.out(1, 0.45)' });
    }

    function resetCartBadge() {
      cartBadgeEl.textContent = '0';
      cartBadgeEl.classList.remove('visible');
    }

    // Clona el ícono del producto clickeado y lo hace "volar" en arco hasta
    // el ícono del carrito, achicándose a su tamaño y desvaneciéndose al
    // final — mismo mecanismo que el ejemplo de Motion (motion.dev/examples
    // /js-add-to-basket), recreado con keyframes de GSAP en vez del
    // path-plugin de esa librería, para no sumar una dependencia nueva.
    function flyToCart(productBtn: HTMLButtonElement) {
      const iconEl = productBtn.querySelector('.mini-product-icon');
      if (!iconEl) return;

      if (prefersReducedMotion()) {
        bumpCartBadge();
        return;
      }

      const fromRect = iconEl.getBoundingClientRect();
      const toRect = cartIconEl.getBoundingClientRect();

      const clone = document.createElement('div');
      clone.className = 'mini-flying-icon';
      clone.innerHTML = iconEl.innerHTML;
      clone.style.left = `${fromRect.left}px`;
      clone.style.top = `${fromRect.top}px`;
      clone.style.width = `${fromRect.width}px`;
      clone.style.height = `${fromRect.height}px`;
      document.body.appendChild(clone);

      const dx = toRect.left + toRect.width / 2 - (fromRect.left + fromRect.width / 2);
      const dy = toRect.top + toRect.height / 2 - (fromRect.top + fromRect.height / 2);
      const flyScale = toRect.width / fromRect.width;

      gsap.to(clone, {
        keyframes: {
          '0%': { x: 0, y: 0, scale: 1, opacity: 1 },
          '55%': { x: dx * 0.5, y: dy * 0.5 - 46, scale: (1 + flyScale) / 2, opacity: 1 },
          '100%': { x: dx, y: dy, scale: flyScale, opacity: 0 },
        },
        duration: 0.5,
        ease: 'power2.inOut',
        onComplete: () => {
          clone.remove();
          bumpCartBadge();
        },
      });
    }

    function updateChange() {
      const total = cart.total();
      const received = Number(receivedInput.value) || 0;
      const change = computeChange(total, received);
      changeEl.textContent = formatCOP(change);
      confirmBtn.disabled = received < total;
    }

    root.querySelectorAll<HTMLButtonElement>('.mini-product').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.classList.add('added');
        cart.add(Number(btn.dataset.price));
        render();
        flyToCart(btn);
      });
    });

    cobrarBtn.addEventListener('click', () => {
      if (cart.items.length === 0) {
        showToast('Agregá primero productos al carrito');
        return;
      }
      const total = cart.total();
      payTotalEl.textContent = formatCOP(total);
      receivedInput.value = String(suggestReceived(total));
      updateChange();
      openModal();
      showPanel(payPanel);
    });

    receivedInput.addEventListener('input', updateChange);

    document.getElementById('miniPayCancel')?.addEventListener('click', () => {
      closeModal();
    });

    confirmBtn.addEventListener('click', () => {
      showPanel(printPanel);

      setTimeout(() => {
        showPanel(alertPanel);

        setTimeout(() => {
          closeModal();
          cart.clear();
          root.querySelectorAll('.mini-product.added').forEach((el) => el.classList.remove('added'));
          render();
          resetCartBadge();
        }, 1800);
      }, 1600);
    });
  }
</script>

<style>
  .mini-demo {
    position: relative;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 18px;
    width: 100%;
    max-width: 320px;
  }

  @media (min-width: 900px) {
    .mini-demo {
      max-width: 400px;
      padding: 24px;
    }
  }
  .mini-demo-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-violet);
    margin: 0 0 60px;
    font-weight: 700;
  }
  .mini-cart-icon {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--accent-violet);
  }

  @media (min-width: 900px) {
    .mini-cart-icon {
      top: 18px;
      right: 18px;
    }
  }

  .mini-cart-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--accent-violet);
    color: #0a0612;
    font-size: 10px;
    font-weight: 800;
    line-height: 16px;
    text-align: center;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.15s var(--ease-out);
  }

  .mini-cart-badge.visible {
    opacity: 1;
  }

  /* Clon volador del ícono del producto — vive en position:fixed en <body>
     (no dentro de .mini-demo) para poder recorrer la pantalla libre de
     cualquier overflow/stacking del contenedor, igual que el modal de cobro
     y el menú del topbar en este mismo proyecto. */
  /* :global() porque este elemento se crea con document.createElement en
     runtime (flyToCart, más abajo) — nunca pasa por el template de Astro,
     así que nunca recibe el atributo data-astro-cid-* que usa el scoping de
     estilos por defecto, y una regla scopeada normal jamás lo alcanzaría. */
  :global(.mini-flying-icon) {
    position: fixed;
    z-index: 150;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-violet);
    pointer-events: none;
    transform-origin: center center;
  }

  .mini-products {
    display: flex;
    gap: 10px;
    margin-bottom: 28px;
    padding: 6px 2px;
  }
  .mini-product {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(155deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    padding: 12px 6px 10px;
    text-align: center;
    cursor: pointer;
    font-size: 11px;
    color: var(--fg);
    font-weight: 600;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s var(--ease-out), border-color 0.15s;
  }
  .mini-product-icon {
    display: flex;
    color: var(--accent-violet);
    margin-bottom: 4px;
  }
  .mini-product-name {
    color: var(--fg-muted);
  }
  .mini-product-price {
    font-size: 13px;
    font-weight: 800;
    color: var(--accent-violet);
    margin-top: 2px;
  }
  /* Desordenadas a propósito, como un mazo de tarjetas tirado sobre la mesa. */
  .mini-products > .mini-product:nth-child(1) {
    transform: rotate(-5deg) translateY(4px);
  }
  .mini-products > .mini-product:nth-child(2) {
    transform: rotate(4deg) translateY(-6px);
  }
  .mini-products > .mini-product:nth-child(3) {
    transform: rotate(-3deg) translateY(5px);
  }
  .mini-product:hover {
    transform: translateY(-4px) scale(1.05) rotate(0deg);
    border-color: var(--accent-violet);
  }
  .mini-product.added {
    border-color: var(--accent-violet);
    background: rgba(150, 110, 255, 0.18);
  }
  .mini-cart-row {
    display: flex;
    justify-content: center;
    margin-bottom: 22px;
  }
  .mini-cart-row span {
    font-size: 26px;
    font-weight: 600;
    color: var(--fg);
  }

  @media (min-width: 900px) {
    .mini-cart-row span {
      font-size: 30px;
    }
  }
  /* Mismo hover 3D (tilt + glare al cursor) que .qr-badge en WhatsAppQR.astro
     — el glare acá es oscuro en vez de blanco (multiply en vez de screen)
     porque este botón ya es un fondo casi blanco, un brillo blanco encima no
     se vería. */
  .mini-cobrar {
    position: relative;
    overflow: hidden;
    width: 100%;
    background: var(--fg);
    border: none;
    color: #0a0612;
    font-weight: 700;
    padding: 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-size: 13px;
    transform: perspective(600px) rotateX(var(--tilt-rx, 0deg)) rotateY(var(--tilt-ry, 0deg)) scale(var(--cobrar-scale, 1));
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.2s var(--ease-out);
  }
  .mini-cobrar:hover {
    --cobrar-scale: 1.03;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3), 0 0 30px rgba(124, 92, 255, 0.22);
  }
  .mini-cobrar:active {
    --cobrar-scale: 0.97;
  }
  .mini-cobrar-glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: multiply;
    background: radial-gradient(circle 120px at var(--tilt-gx, 50%) var(--tilt-gy, 50%), rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0) 70%);
    transition: opacity 0.3s var(--ease-out);
  }
  .mini-cobrar:hover .mini-cobrar-glare {
    opacity: 1;
  }

  .mini-toast {
    position: fixed;
    left: 50%;
    bottom: 32px;
    z-index: 200;
    transform: translate(-50%, 12px);
    background: #0d0a14;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--fg);
    font-size: 13px;
    font-weight: 600;
    padding: 12px 20px;
    border-radius: var(--radius-pill);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .mini-toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Modal a nivel de página: fixed (no absolute) para escapar de .mini-demo y
     cubrir/bloquear todo el sitio, con blur del contenido de atrás. */
  .mini-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(4, 3, 8, 0.6);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-out);
  }
  .mini-modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mini-modal-panel {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 340px;
    background: #0d0a14;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    padding: 26px 24px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
  }
  .mini-modal-panel.show {
    display: flex;
  }

  .mini-dialog-method-row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--fg-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 9px 12px;
    margin-bottom: 16px;
  }
  .mini-dialog-method-value {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--fg);
    font-weight: 700;
  }

  .mini-dialog-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    margin: 0 0 4px;
  }
  .mini-dialog-total {
    font-size: 26px;
    font-weight: 800;
    margin: 0 0 18px;
  }
  .mini-dialog-label {
    align-self: flex-start;
    font-size: 12px;
    color: var(--fg-muted);
    margin-bottom: 6px;
  }
  .mini-dialog-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    padding: 10px 12px;
    color: var(--fg);
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 14px;
  }
  .mini-dialog-input:focus {
    outline: none;
    border-color: var(--accent-violet);
  }
  .mini-dialog-change-row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--fg-muted);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 12px;
    margin-bottom: 18px;
  }
  .mini-dialog-change-row span:last-child {
    color: #8ff0ac;
    font-weight: 800;
    font-size: 15px;
  }
  .mini-dialog-actions {
    display: flex;
    gap: 10px;
    width: 100%;
  }
  .mini-dialog-cancel {
    flex: 1;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--fg);
    font-weight: 600;
    padding: 11px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-size: 13px;
  }
  .mini-dialog-confirm {
    flex: 1;
    background: var(--accent-violet);
    border: none;
    color: #0a0612;
    font-weight: 700;
    padding: 11px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-size: 13px;
  }
  .mini-dialog-confirm:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .mini-spinner {
    width: 34px;
    height: 34px;
    border: 3px solid rgba(255, 255, 255, 0.15);
    border-top-color: var(--accent-violet);
    border-radius: 50%;
    animation: miniSpin 0.8s linear infinite;
    margin-bottom: 14px;
  }
  @keyframes miniSpin {
    to {
      transform: rotate(360deg);
    }
  }
  .mini-print-panel p {
    font-size: 13px;
    color: var(--fg-muted);
    margin: 0;
  }

  .mini-alert-icon {
    display: flex;
    color: #8ff0ac;
    margin-bottom: 10px;
  }
  .mini-alert-title {
    font-size: 16px;
    font-weight: 800;
    margin: 0 0 4px;
  }
  .mini-alert-sub {
    font-size: 12px;
    color: var(--fg-muted);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-spinner {
      animation-duration: 1.6s;
    }
  }

  @media (max-width: 400px) {
    .mini-products {
      flex-direction: column;
    }
  }
</style>
