---
interface Props {
  alt: string;
  dimmed?: boolean;
  src?: string;
}

const { alt, dimmed = false, src } = Astro.props;
---

<div class:list={['screenshot-frame', { dimmed }]}>
  {src ? (
    <img class="screenshot-image" src={src} alt={alt} loading="lazy" />
  ) : (
    <span class="screenshot-placeholder">[captura real: {alt}]</span>
  )}
</div>

<style>
  .screenshot-frame {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .screenshot-frame::before {
    content: '';
    position: absolute;
    inset: -30%;
    filter: blur(30px);
    opacity: 0.55;
    z-index: 0;
    background: radial-gradient(circle, var(--section-accent-glow, var(--accent-violet-glow)), transparent 70%);
  }
  .screenshot-frame.dimmed {
    opacity: 0.6;
  }

  @media (min-width: 900px) {
    .screenshot-frame {
      max-width: 560px;
    }
  }
  .screenshot-placeholder {
    position: relative;
    z-index: 1;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
    text-align: center;
    padding: 0 16px;
  }
  .screenshot-image {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
