---
import CTAButton from './CTAButton.astro';
---

<section class="final-cta" data-section-id="cta">
  <h2>Iniciá tu prueba gratis de 20 días.</h2>
  <p>Sin tarjeta — activá tu cuenta en minutos y probá todo el sistema.</p>
  <CTAButton href="/prueba-gratis">Iniciar prueba gratis</CTAButton>
</section>

<style>
  .final-cta {
    text-align: center;
    padding: 100px 24px;
    max-width: 480px;
    margin: 0 auto;
  }
  .final-cta h2 {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 800;
    margin: 0 0 12px;
  }
  .final-cta p {
    color: var(--fg-muted);
    margin: 0 0 28px;
  }
</style>
