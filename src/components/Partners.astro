---
interface Partner {
  name: string;
  src: string;
  /** Dimensiones intrínsecas reales del archivo — con esto el navegador reserva el espacio antes de cargar la imagen y no salta el layout (CLS). */
  width: number;
  height: number;
  /** Para bajarlo temporalmente de la franja sin perder el logo ya conseguido. */
  hidden?: boolean;
}

const partners: Partner[] = [
  { name: 'Alegra', src: '/aliados/alegra.svg', width: 57, height: 19 },
  { name: 'Wompi', src: '/aliados/wompi.svg', width: 1332, height: 348 },
  // Ocultos por ahora para el MVP — logos ya listos, solo hay que sacarles el `hidden` cuando se reactiven.
  { name: 'Fondo Emprender - SENA', src: '/aliados/fondo-emprender.svg', width: 1568, height: 414, hidden: true },
  { name: 'Interrapidísimo', src: '/aliados/interrapidisimo.png', width: 1660, height: 360, hidden: true },
];

const visiblePartners = partners.filter((p) => !p.hidden);
---

<section class="partners" aria-label="Aliados">
  <p class="partners-eyebrow">Aliados</p>
  <ul class="partners-list">
    {visiblePartners.map((partner) => (
      <li>
        <img
          class="partners-logo"
          src={partner.src}
          alt={partner.name}
          width={partner.width}
          height={partner.height}
          loading="lazy"
        />
      </li>
    ))}
  </ul>
</section>

<style>
  .partners {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: 40px 24px 88px;
    text-align: center;
  }
  .partners-eyebrow {
    font-size: clamp(26px, 3.4vw, 34px);
    font-weight: 800;
    letter-spacing: 0.01em;
    color: var(--fg);
    margin: 0;
  }
  .partners-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 44px 64px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .partners-logo {
    display: block;
    height: 40px;
    width: auto;
    /* Todos los logos entran con el mismo tratamiento monocromo (silueta
       blanca), sin importar sus colores originales — se ven a color recién
       al hacer hover, como el resto de los hovers del sitio. */
    filter: brightness(0) invert(1);
    opacity: 0.5;
    transition: opacity 0.25s var(--ease-out), filter 0.25s var(--ease-out);
  }
  .partners-logo:hover {
    filter: none;
    opacity: 1;
  }

  @media (min-width: 900px) {
    .partners-logo {
      height: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-logo {
      transition: none;
    }
  }
</style>
