---
import Layout from '../layouts/Layout.astro';
import { pricingPlans } from '../lib/pricingPlans';
import { formatCOP } from '../lib/formatCurrency';
---

<Layout title="Iniciá tu prueba gratis — AURA" description="20 días gratis, sin tarjeta. Creá tu cuenta de AURA y empezá a vender.">
  <section class="signup">
    <h1>20 días gratis, sin tarjeta</h1>
    <form id="signup-form">
      <label>
        Nombre del negocio
        <input type="text" name="nombreNegocio" required />
      </label>
      <label>
        Tu nombre
        <input type="text" name="adminNombre" required />
      </label>
      <label>
        Email
        <input type="email" name="adminEmail" required />
      </label>
      <label>
        Contraseña
        <input type="password" name="adminPassword" minlength="6" required />
      </label>
      <fieldset>
        <legend>Elegí tu paquete</legend>
        {pricingPlans.map((plan) => (
          <label class="plan-option">
            <input type="radio" name="paqueteId" value={plan.paqueteId} data-plan-slug={plan.id} required />
            <span>{plan.name} — {formatCOP(plan.price)}/mes</span>
          </label>
        ))}
      </fieldset>
      <button type="submit">Crear cuenta</button>
      <p id="signup-mensaje"></p>
    </form>
  </section>
</Layout>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000/api';
  const form = document.getElementById('signup-form') as HTMLFormElement;
  const mensaje = document.getElementById('signup-mensaje')!;
  const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  // `output: 'static'` — no hay request real en build time, así que la
  // preselección del plan que viene de /planes (?plan=slug) se resuelve acá
  // en el cliente, no en el frontmatter de Astro (Astro.url ahí es el de
  // build, sin query string real).
  const planPreseleccionado = new URLSearchParams(window.location.search).get('plan');
  if (planPreseleccionado) {
    const radio = form.querySelector<HTMLInputElement>(
      `input[name="paqueteId"][data-plan-slug="${planPreseleccionado}"]`,
    );
    if (radio) radio.checked = true;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitButton.disabled = true;
    mensaje.textContent = '';
    mensaje.classList.remove('signup-mensaje-error');

    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch(`${API_URL}/negocios/registro-publico`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        form.style.display = 'none';
        mensaje.textContent = 'Cuenta creada — revisá tu correo para confirmarla.';
      } else {
        const body = await res.json().catch(() => ({}));
        mensaje.textContent = body.message ?? 'No se pudo crear la cuenta, intentá de nuevo.';
        mensaje.classList.add('signup-mensaje-error');
        submitButton.disabled = false;
      }
    } catch {
      mensaje.textContent = 'No se pudo conectar con el servidor, intentá de nuevo.';
      mensaje.classList.add('signup-mensaje-error');
      submitButton.disabled = false;
    }
  });
</script>

<style>
  .signup {
    max-width: 480px;
    margin: 0 auto;
    padding: calc(var(--topbar-height) + 48px) 24px 64px;
  }
  .signup h1 {
    font-size: 28px;
    margin: 0 0 24px;
    color: var(--fg);
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    color: var(--fg-muted);
  }
  input[type='text'],
  input[type='email'],
  input[type='password'] {
    padding: 12px 16px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 15px;
  }
  fieldset {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  legend {
    padding: 0 6px;
    font-size: 13px;
    color: var(--fg-muted);
  }
  .plan-option {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--fg);
  }
  button[type='submit'] {
    padding: 14px 26px;
    border-radius: var(--radius-pill);
    border: none;
    font-weight: 700;
    font-size: 14px;
    background: var(--fg);
    color: #0a0612;
    cursor: pointer;
  }
  button[type='submit']:disabled {
    opacity: 0.6;
    cursor: default;
  }
  #signup-mensaje {
    font-size: 13px;
    color: var(--accent-teal);
  }
  #signup-mensaje.signup-mensaje-error {
    color: var(--accent-pink);
  }
</style>
