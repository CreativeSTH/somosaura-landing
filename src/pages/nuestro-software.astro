---
import Layout from '../layouts/Layout.astro';
import ComponentZone from '../components/ComponentZone.astro';
import ComponentDialog from '../components/ComponentDialog.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Partners from '../components/Partners.astro';
import Footer from '../components/Footer.astro';
import { categories, components } from '../lib/softwareComponents';
---

<Layout
  title="Nuestro software, a fondo — AURA"
  description="Todos los componentes de AURA explicados: catálogo, clientes, ventas y negocio. Hacé click en cualquiera para ver cómo funciona."
>
  <main>
    <header class="software-hero">
      <p class="software-hero-eyebrow">Nuestro software</p>
      <h1 class="software-hero-title">Todo lo que hace Aura, a fondo.</h1>
      <p class="software-hero-copy">Tocá cualquier tarjeta para ver cómo funciona.</p>
    </header>

    {categories.map((category) => (
      <ComponentZone category={category} items={components.filter((c) => c.category === category.id)} />
    ))}

    <FinalCTA />
    <Partners />
  </main>
  <Footer />
  <ComponentDialog />
</Layout>

<style>
  .software-hero {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    padding: 64px 24px 24px;
  }
  .software-hero-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--accent-violet);
    margin: 0 0 12px;
  }
  .software-hero-title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 800;
    line-height: 1.12;
    margin: 0 0 12px;
  }
  .software-hero-copy {
    font-size: 15px;
    color: var(--fg-muted);
    margin: 0;
  }

  @media (min-width: 900px) {
    .software-hero {
      padding: 96px 24px 32px;
    }
  }
</style>
