---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import SiteNav from '../components/SiteNav.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Partners from '../components/Partners.astro';
import Footer from '../components/Footer.astro';
import { aboutSections } from '../lib/aboutSections';
---

<Layout
  title="¿Qué es Aura? — AURA"
  description="Aura es el software de administración de punto comercial que simplifica la venta digital y la gestión diaria de tu negocio: ventas, facturación, inventario, clientes, envíos y reportes en un solo lugar."
>
  <SiteNav sections={aboutSections} />
  <main>
    {aboutSections.map((section, i) => (
      <Section section={section} reverse={i % 2 === 1} headingLevel={i === 0 ? 'h1' : 'h2'} />
    ))}
    <FinalCTA />
    <Partners />
  </main>
  <Footer />
</Layout>
