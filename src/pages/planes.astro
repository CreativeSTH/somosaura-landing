---
import Layout from '../layouts/Layout.astro';
import PricingCard from '../components/PricingCard.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Partners from '../components/Partners.astro';
import Footer from '../components/Footer.astro';
import { pricingPlans } from '../lib/pricingPlans';

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER;

function whatsappHrefFor(planName: string) {
  const message = encodeURIComponent(`Quiero probar AURA (${planName}) gratis por 20 días.`);
  return `https://wa.me/${whatsappNumber}?text=${message}`;
}
---

<Layout
  title="Planes y precios — AURA"
  description="Elegí el plan de AURA que le queda a tu negocio: POS Básico, Profesional o Empresarial. Facturación electrónica DIAN incluida desde el plan Profesional."
>
  <main>
    <header class="pricing-hero">
      <p class="pricing-hero-eyebrow">Planes</p>
      <h1 class="pricing-hero-title">Un plan para cada tamaño de negocio.</h1>
      <p class="pricing-hero-copy">
        Empezá simple y subí de plan cuando la DIAN te lo exija o tu negocio crezca — sin perder nada de lo que ya tenías.
      </p>
    </header>

    <section class="pricing-grid">
      {pricingPlans.map((plan) => (
        <PricingCard plan={plan} ctaHref={whatsappHrefFor(plan.name)} />
      ))}
    </section>

    <FinalCTA />
    <Partners />
  </main>
  <Footer />
</Layout>

<style>
  .pricing-hero {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    padding: 64px 24px 48px;
  }
  .pricing-hero-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--accent-violet);
    margin: 0 0 12px;
  }
  .pricing-hero-title {
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 12px;
  }
  .pricing-hero-copy {
    font-size: 15px;
    line-height: 1.5;
    color: var(--fg-muted);
    margin: 0;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 1080px;
    margin: 0 auto;
    padding: 8px 24px 60px;
  }

  @media (min-width: 900px) {
    .pricing-hero {
      padding: 96px 24px 56px;
    }
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
      padding: 16px 60px 80px;
      align-items: stretch;
    }
    .pricing-grid :global(.pricing-card-highlight) {
      transform: translateY(-10px);
    }
  }
</style>
